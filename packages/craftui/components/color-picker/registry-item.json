{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "craftui-color-picker",
	"type": "registry:component",
	"description": "A comprehensive, accessible color picker with 2D saturation/brightness area, hue and alpha sliders, format switching, eyedropper, and swatches.",
	"dependencies": [
		"@base-ui/react",
		"class-variance-authority",
		"cn",
		"lucide-react"
	],
	"registryDependencies": ["@craftdotui/baseui-popover"],
	"files": [
		{
			"path": "packages/craftui/components/color-picker/index.tsx",
			"type": "registry:component",
			"target": "components/ui/color-picker.tsx"
		},
		{
			"path": "packages/craftui/components/color-picker/color-utils.ts",
			"type": "registry:component",
			"target": "components/ui/color-utils.ts"
		}
	]
}
