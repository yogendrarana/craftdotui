{
	"extends": "@craftdotui/tsconfig/nextjs.json",
	"compilerOptions": {
		"paths": {
			"@/*": ["./src/*"],
			"@/__registry__": ["./__registry__"],
			"content-collections": ["./.content-collections/generated"],
			"@craftdotui/baseui/*": ["../../packages/baseui/*"],
			"@craftdotui/craftui/*": ["../../packages/craftui/*"],
			"@craftdotui/hooks/*": ["../../packages/hooks/*"],
			"@craftdotui/loaders/*": ["../../packages/loaders/*"],
			"@craftdotui/motion/*": ["../../packages/motion/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"next.config.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
