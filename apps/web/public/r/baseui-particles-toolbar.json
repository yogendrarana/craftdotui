			"content": "\"use client\";\n\nimport {\n\tToolbarRoot,\n\tToolbarButton,\n\tToolbarSeparator,\n\tToolbarLink,\n} from \"@/components/baseui/components/toolbar\";\n\nimport {\n\tToggleGroup,\n\tToggleGroupItem,\n} from \"@/components/baseui/components/toggle-group\";\n\nimport {\n\tSelect,\n\tSelectTrigger,\n\tSelectValue,\n\tSelectPortal,\n\tSelectPositioner,\n\tSelectPopup,\n\tSelectItem,\n} from \"@/components/baseui/components/select\";\n\nimport {\n\tNumberFieldRoot,\n\tNumberFieldGroup,\n\tNumberFieldInput,\n\tNumberFieldIncrement,\n\tNumberFieldDecrement,\n} from \"@/components/baseui/components/number-field\";\n\nimport {\n\tBold,\n\tItalic,\n\tUnderline,\n\tAlignLeft,\n\tAlignCenter,\n\tAlignRight,\n\tUndo,\n\tRedo,\n} from \"lucide-react\";\n\nexport function Particle() {\n\treturn (\n\t\t<div>\n\t\t\t<ToolbarRoot>\n\t\t\t\t{/* Text formatting */}\n\t\t\t\t<ToggleGroup multiple className=\"flex gap-0.5\">\n\t\t\t\t\t<ToolbarButton\n\t\t\t\t\t\trender={\n\t\t\t\t\t\t\t<ToggleGroupItem value=\"bold\">\n\t\t\t\t\t\t\t\t<Bold className=\"size-4\" />\n\t\t\t\t\t\t\t</ToggleGroupItem>\n\t\t\t\t\t\t}\n\t\t\t\t\t\taria-label=\"Bold\"\n\t\t\t\t\t\tsize=\"icon\"\n\t\t\t\t\t/>\n\n\t\t\t\t\t<ToolbarButton\n\t\t\t\t\t\trender={\n\t\t\t\t\t\t\t<ToggleGroupItem value=\"italic\">\n\t\t\t\t\t\t\t\t<Italic className=\"size-4\" />\n\t\t\t\t\t\t\t</ToggleGroupItem>\n\t\t\t\t\t\t}\n\t\t\t\t\t\taria-label=\"Italic\"\n\t\t\t\t\t\tsize=\"icon\"\n\t\t\t\t\t/>\n\n\t\t\t\t\t<ToolbarButton\n\t\t\t\t\t\trender={\n\t\t\t\t\t\t\t<ToggleGroupItem value=\"underline\">\n\t\t\t\t\t\t\t\t<Underline className=\"size-4\" />\n\t\t\t\t\t\t\t</ToggleGroupItem>\n\t\t\t\t\t\t}\n\t\t\t\t\t\taria-label=\"Underline\"\n\t\t\t\t\t\tsize=\"icon\"\n\t\t\t\t\t/>\n\t\t\t\t</ToggleGroup>\n\n\t\t\t\t<ToolbarSeparator />\n\n\t\t\t\t{/* Text alignment */}\n\t\t\t\t<ToggleGroup defaultValue={[\"left\"]} className=\"flex gap-0.5\">\n\t\t\t\t\t<ToolbarButton\n\t\t\t\t\t\trender={\n\t\t\t\t\t\t\t<ToggleGroupItem value=\"left\">\n\t\t\t\t\t\t\t\t<AlignLeft className=\"size-4\" />\n\t\t\t\t\t\t\t</ToggleGroupItem>\n\t\t\t\t\t\t}\n\t\t\t\t\t\taria-label=\"Align left\"\n\t\t\t\t\t\tsize=\"icon\"\n\t\t\t\t\t/>\n\n\t\t\t\t\t<ToolbarButton\n\t\t\t\t\t\trender={\n\t\t\t\t\t\t\t<ToggleGroupItem value=\"center\">\n\t\t\t\t\t\t\t\t<AlignCenter className=\"size-4\" />\n\t\t\t\t\t\t\t</ToggleGroupItem>\n\t\t\t\t\t\t}\n\t\t\t\t\t\taria-label=\"Align center\"\n\t\t\t\t\t\tsize=\"icon\"\n\t\t\t\t\t/>\n\n\t\t\t\t\t<ToolbarButton\n\t\t\t\t\t\trender={\n\t\t\t\t\t\t\t<ToggleGroupItem value=\"right\">\n\t\t\t\t\t\t\t\t<AlignRight className=\"size-4\" />\n\t\t\t\t\t\t\t</ToggleGroupItem>\n\t\t\t\t\t\t}\n\t\t\t\t\t\taria-label=\"Align right\"\n\t\t\t\t\t\tsize=\"icon\"\n\t\t\t\t\t/>\n\t\t\t\t</ToggleGroup>\n\n\t\t\t\t<ToolbarSeparator />\n\n\t\t\t\t{/* Font family */}\n\t\t\t\t<Select defaultValue=\"inter\">\n\t\t\t\t\t<ToolbarButton render={<SelectTrigger className=\"w-30\" />}>\n\t\t\t\t\t\t<SelectValue />\n\t\t\t\t\t</ToolbarButton>\n\n\t\t\t\t\t<SelectPortal>\n\t\t\t\t\t\t<SelectPositioner sideOffset={6}>\n\t\t\t\t\t\t\t<SelectPopup>\n\t\t\t\t\t\t\t\t<SelectItem value=\"inter\">Inter</SelectItem>\n\t\t\t\t\t\t\t\t<SelectItem value=\"system\">\n\t\t\t\t\t\t\t\t\tSystem UI\n\t\t\t\t\t\t\t\t</SelectItem>\n\t\t\t\t\t\t\t\t<SelectItem value=\"mono\">Monospace</SelectItem>\n\t\t\t\t\t\t\t</SelectPopup>\n\t\t\t\t\t\t</SelectPositioner>\n\t\t\t\t\t</SelectPortal>\n\t\t\t\t</Select>\n\n\t\t\t\t<ToolbarSeparator />\n\n\t\t\t\t{/* Font size */}\n\t\t\t\t<NumberFieldRoot defaultValue={12} min={0} max={100}>\n\t\t\t\t\t<NumberFieldGroup className=\"gap-1\">\n\t\t\t\t\t\t<NumberFieldDecrement variant=\"ghost\" />\n\t\t\t\t\t\t<NumberFieldInput\n\t\t\t\t\t\t\tclassName=\"w-14 border rounded-md\"\n\t\t\t\t\t\t\tvariant=\"ghost\"\n\t\t\t\t\t\t/>\n\t\t\t\t\t\t<NumberFieldIncrement variant=\"ghost\" />\n\t\t\t\t\t</NumberFieldGroup>\n\t\t\t\t</NumberFieldRoot>\n\n\t\t\t\t<ToolbarSeparator />\n\n\t\t\t\t{/* Undo/Redo */}\n\t\t\t\t<ToolbarButton size=\"icon\" aria-label=\"Undo\">\n\t\t\t\t\t<Undo className=\"h-4 w-4\" />\n\t\t\t\t</ToolbarButton>\n\t\t\t\t<ToolbarButton size=\"icon\" aria-label=\"Redo\">\n\t\t\t\t\t<Redo className=\"h-4 w-4\" />\n\t\t\t\t</ToolbarButton>\n\n\t\t\t\t<ToolbarSeparator />\n\n\t\t\t\t{/* Right-aligned metadata */}\n\t\t\t\t<ToolbarLink\n\t\t\t\t\thref=\"#\"\n\t\t\t\t\tclassName=\"ml-auto px-2 text-xs text-muted-foreground hover:text-foreground\"\n\t\t\t\t>\n\t\t\t\t\tEdited just now\n\t\t\t\t</ToolbarLink>\n\t\t\t</ToolbarRoot>\n\t\t</div>\n\t);\n}\n",
