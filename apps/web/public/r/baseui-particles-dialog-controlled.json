	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "baseui-particles-dialog-controlled",
	"description": "Controlled dialog example",
	"dependencies": [],
	"registryDependencies": [
		"@craftdotui/baseui-dialog",
