			"content": "import {\n\tTooltipRoot,\n\tTooltipContent,\n\tTooltipProvider,\n\tTooltipTrigger,\n} from \"@/components/baseui/components/tooltip\";\nimport { Button } from \"@/components/baseui/components/button\";\n\nexport function Particle() {\n\treturn (\n\t\t<TooltipProvider>\n\t\t\t<div className=\"grid grid-cols-2 grid-rows-2 gap-2\">\n\t\t\t\t<TooltipRoot>\n\t\t\t\t\t<TooltipTrigger\n\t\t\t\t\t\trender={\n\t\t\t\t\t\t\t<Button className=\"w-20\" variant=\"outline\">\n\t\t\t\t\t\t\t\tTop\n\t\t\t\t\t\t\t</Button>\n\t\t\t\t\t\t}\n\t\t\t\t\t/>\n\t\t\t\t\t<TooltipContent positionerProps={{ side: \"top\" }}>\n\t\t\t\t\t\tTooltip on top\n\t\t\t\t\t</TooltipContent>\n\t\t\t\t</TooltipRoot>\n\n\t\t\t\t<TooltipRoot>\n\t\t\t\t\t<TooltipTrigger\n\t\t\t\t\t\trender={\n\t\t\t\t\t\t\t<Button className=\"w-20\" variant=\"outline\">\n\t\t\t\t\t\t\t\tRight\n\t\t\t\t\t\t\t</Button>\n\t\t\t\t\t\t}\n\t\t\t\t\t/>\n\t\t\t\t\t<TooltipContent positionerProps={{ side: \"right\" }}>\n\t\t\t\t\t\tTooltip on right\n\t\t\t\t\t</TooltipContent>\n\t\t\t\t</TooltipRoot>\n\n\t\t\t\t<TooltipRoot>\n\t\t\t\t\t<TooltipTrigger\n\t\t\t\t\t\trender={\n\t\t\t\t\t\t\t<Button className=\"w-20\" variant=\"outline\">\n\t\t\t\t\t\t\t\tLeft\n\t\t\t\t\t\t\t</Button>\n\t\t\t\t\t\t}\n\t\t\t\t\t/>\n\t\t\t\t\t<TooltipContent positionerProps={{ side: \"left\" }}>\n\t\t\t\t\t\tTooltip on left\n\t\t\t\t\t</TooltipContent>\n\t\t\t\t</TooltipRoot>\n\n\t\t\t\t<TooltipRoot>\n\t\t\t\t\t<TooltipTrigger\n\t\t\t\t\t\trender={\n\t\t\t\t\t\t\t<Button className=\"w-20\" variant=\"outline\">\n\t\t\t\t\t\t\t\tBottom\n\t\t\t\t\t\t\t</Button>\n\t\t\t\t\t\t}\n\t\t\t\t\t/>\n\t\t\t\t\t<TooltipContent positionerProps={{ side: \"bottom\" }}>\n\t\t\t\t\t\tTooltip on bottom\n\t\t\t\t\t</TooltipContent>\n\t\t\t\t</TooltipRoot>\n\t\t\t</div>\n\t\t</TooltipProvider>\n\t);\n}\n\nexport default Particle;\n",
