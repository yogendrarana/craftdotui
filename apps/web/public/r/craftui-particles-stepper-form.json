		{
			"path": "packages/craftui/particles/stepper/form/index.tsx",
			"content": "\"use client\";\n\nimport * as React from \"react\";\nimport { Button } from \"@/components/baseui/components/button\";\nimport {\n\tFieldControl,\n\tFieldDescription,\n\tFieldLabel,\n\tFieldRoot,\n} from \"@/components/baseui/components/field\";\nimport {\n\tStepperContent,\n\tStepperIndicator,\n\tStepperItem,\n\tStepperList,\n\tStepperNext,\n\tStepperPrev,\n\tStepperRoot,\n\tStepperSeparator,\n\tStepperTitle,\n\tStepperTrigger,\n} from \"@/components/craftui/components/stepper\";\n\nexport function Particle() {\n\tconst [step, setStep] = React.useState(1);\n\tconst [formData, setFormData] = React.useState({\n\t\tname: \"Yogendra Rana\",\n\t\temail: \"yogendra@craftdotui.com\",\n\t\tworkspace: \"Craft UI\",\n\t\tslug: \"craft-ui\",\n\t});\n\n\treturn (\n\t\t<StepperRoot\n\t\t\tvalue={step}\n\t\t\tonValueChange={setStep}\n\t\t\tclassName=\"mx-auto w-full max-w-lg rounded-lg border border-border bg-card p-5\"\n\t\t>\n\t\t\t<StepperList>\n\t\t\t\t<StepperItem step={1}>\n\t\t\t\t\t<StepperTrigger>\n\t\t\t\t\t\t<StepperIndicator />\n\t\t\t\t\t\t<StepperTitle>Profile</StepperTitle>\n\t\t\t\t\t</StepperTrigger>\n\t\t\t\t\t<StepperSeparator />\n\t\t\t\t</StepperItem>\n\n\t\t\t\t<StepperItem step={2}>\n\t\t\t\t\t<StepperTrigger>\n\t\t\t\t\t\t<StepperIndicator />\n\t\t\t\t\t\t<StepperTitle>Workspace</StepperTitle>\n\t\t\t\t\t</StepperTrigger>\n\t\t\t\t\t<StepperSeparator />\n\t\t\t\t</StepperItem>\n\n\t\t\t\t<StepperItem step={3}>\n\t\t\t\t\t<StepperTrigger>\n\t\t\t\t\t\t<StepperIndicator />\n\t\t\t\t\t\t<StepperTitle>Review</StepperTitle>\n\t\t\t\t\t</StepperTrigger>\n\t\t\t\t</StepperItem>\n\t\t\t</StepperList>\n\n\t\t\t<StepperContent step={1} className=\"flex flex-col gap-3\">\n\t\t\t\t<FieldRoot>\n\t\t\t\t\t<FieldLabel>Full Name</FieldLabel>\n\t\t\t\t\t<FieldControl\n\t\t\t\t\t\tplaceholder=\"Enter your name\"\n\t\t\t\t\t\tvalue={formData.name}\n\t\t\t\t\t\tonChange={(e) =>\n\t\t\t\t\t\t\tsetFormData((prev) => ({\n\t\t\t\t\t\t\t\t...prev,\n\t\t\t\t\t\t\t\tname: e.target.value,\n\t\t\t\t\t\t\t}))\n\t\t\t\t\t\t}\n\t\t\t\t\t/>\n\t\t\t\t</FieldRoot>\n\t\t\t\t<FieldRoot>\n\t\t\t\t\t<FieldLabel>Email Address</FieldLabel>\n\t\t\t\t\t<FieldControl\n\t\t\t\t\t\ttype=\"email\"\n\t\t\t\t\t\tplaceholder=\"you@example.com\"\n\t\t\t\t\t\tvalue={formData.email}\n\t\t\t\t\t\tonChange={(e) =>\n\t\t\t\t\t\t\tsetFormData((prev) => ({\n\t\t\t\t\t\t\t\t...prev,\n\t\t\t\t\t\t\t\temail: e.target.value,\n\t\t\t\t\t\t\t}))\n\t\t\t\t\t\t}\n\t\t\t\t\t/>\n\t\t\t\t</FieldRoot>\n\t\t\t</StepperContent>\n\n\t\t\t<StepperContent step={2} className=\"flex flex-col gap-3\">\n\t\t\t\t<FieldRoot>\n\t\t\t\t\t<FieldLabel>Workspace Name</FieldLabel>\n\t\t\t\t\t<FieldControl\n\t\t\t\t\t\tplaceholder=\"Acme Inc.\"\n\t\t\t\t\t\tvalue={formData.workspace}\n\t\t\t\t\t\tonChange={(e) =>\n\t\t\t\t\t\t\tsetFormData((prev) => ({\n\t\t\t\t\t\t\t\t...prev,\n\t\t\t\t\t\t\t\tworkspace: e.target.value,\n\t\t\t\t\t\t\t}))\n\t\t\t\t\t\t}\n\t\t\t\t\t/>\n\t\t\t\t</FieldRoot>\n\t\t\t\t<FieldRoot>\n\t\t\t\t\t<FieldLabel>Workspace URL</FieldLabel>\n\t\t\t\t\t<FieldControl\n\t\t\t\t\t\tplaceholder=\"acme\"\n\t\t\t\t\t\tvalue={formData.slug}\n\t\t\t\t\t\tonChange={(e) =>\n\t\t\t\t\t\t\tsetFormData((prev) => ({\n\t\t\t\t\t\t\t\t...prev,\n\t\t\t\t\t\t\t\tslug: e.target.value,\n\t\t\t\t\t\t\t}))\n\t\t\t\t\t\t}\n\t\t\t\t\t/>\n\t\t\t\t\t<FieldDescription>\n\t\t\t\t\t\tcraftdotui.com/{formData.slug || \"workspace\"}\n\t\t\t\t\t</FieldDescription>\n\t\t\t\t</FieldRoot>\n\t\t\t</StepperContent>\n\n\t\t\t<StepperContent step={3}>\n\t\t\t\t<div className=\"flex flex-col gap-2 rounded-md border border-border bg-muted/30 p-3.5 text-sm\">\n\t\t\t\t\t<div className=\"flex justify-between\">\n\t\t\t\t\t\t<span className=\"text-muted-foreground\">Name</span>\n\t\t\t\t\t\t<span className=\"font-medium text-foreground\">\n\t\t\t\t\t\t\t{formData.name}\n\t\t\t\t\t\t</span>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div className=\"flex justify-between\">\n\t\t\t\t\t\t<span className=\"text-muted-foreground\">Email</span>\n\t\t\t\t\t\t<span className=\"font-medium text-foreground\">\n\t\t\t\t\t\t\t{formData.email}\n\t\t\t\t\t\t</span>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div className=\"flex justify-between\">\n\t\t\t\t\t\t<span className=\"text-muted-foreground\">Workspace</span>\n\t\t\t\t\t\t<span className=\"font-medium text-foreground\">\n\t\t\t\t\t\t\t{formData.workspace} ({formData.slug})\n\t\t\t\t\t\t</span>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</StepperContent>\n\n\t\t\t<div className=\"flex items-center justify-end gap-2 border-t border-border pt-4\">\n\t\t\t\t<StepperPrev render={<Button variant=\"outline\" size=\"sm\" />}>\n\t\t\t\t\tBack\n\t\t\t\t</StepperPrev>\n\t\t\t\t{step < 3 ? (\n\t\t\t\t\t<StepperNext render={<Button size=\"sm\" />}>\n\t\t\t\t\t\tContinue\n\t\t\t\t\t</StepperNext>\n\t\t\t\t) : (\n\t\t\t\t\t<Button size=\"sm\" onClick={() => setStep(1)}>\n\t\t\t\t\t\tCreate Workspace\n\t\t\t\t\t</Button>\n\t\t\t\t)}\n\t\t\t</div>\n\t\t</StepperRoot>\n\t);\n}\n\nexport default Particle;\n",
			"type": "registry:component",
			"target": "components/particles/stepper-form.tsx"
		}
	],
	"type": "registry:component"
