nset\" variant=\"destructive\">\n\t\t\t\t<BannerIcon>\n\t\t\t\t\t<AlertCircle />\n\t\t\t\t</BannerIcon>\n\t\t\t\t<BannerContent>\n\t\t\t\t\t<BannerTitle>Destructive:</BannerTitle>\n\t\t\t\t\t<BannerDescription>\n\t\t\t\t\t\tPayment failed. Please update billing info.\n\t\t\t\t\t</BannerDescription>\n\t\t\t\t</BannerContent>\n\t\t\t\t<BannerClose />\n\t\t\t</BannerRoot>\n\n\t\t\t<BannerRoot appearance=\"inset\" variant=\"promotional\">\n\t\t\t\t<BannerIcon>\n\t\t\t\t\t<Sparkles />\n\t\t\t\t</BannerIcon>\n\t\t\t\t<BannerContent>\n\t\t\t\t\t<BannerTitle>Promotional:</BannerTitle>\n\t\t\t\t\t<BannerDescription>\n\t\t\t\t\t\tUpgrade to Enterprise with 30% discount today.\n\t\t\t\t\t</BannerDescription>\n\t\t\t\t</BannerContent>\n\t\t\t\t<BannerClose />\n\t\t\t</BannerRoot>\n\t\t</div>\n\t);\n}\n\nexport default Particle;\n",
