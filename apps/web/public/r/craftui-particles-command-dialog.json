{
	"$schema": "https://ui.shadcn.com/schema/registry-item.json",
	"name": "craftui-particles-command-dialog",
	"description": "Modal command palette dialog with keyboard shortcut trigger and footer hints",
	"dependencies": ["lucide-react"],
	"registryDependencies": [
		"@craftdotui/craftui-command",
		"@craftdotui/craftui-kbd",
		"@craftdotui/baseui-button"
	],
	"files": [
		{
			"path": "packages/craftui/components/command/particles/dialog/index.tsx",
			"content": "\"use client\";\n\nimport * as React from \"react\";\nimport {\n\tCalculatorIcon,\n\tCalendarIcon,\n\tCornerDownLeftIcon,\n\tCreditCardIcon,\n\tSearchIcon,\n\tSettingsIcon,\n\tSmileIcon,\n\tUserIcon,\n} from \"lucide-react\";\nimport { Button } from \"@/components/baseui/components/button\";\nimport {\n\tCommandDialog,\n\tCommandEmpty,\n\tCommandFooter,\n\tCommandGroup,\n\tCommandInput,\n\tCommandItem,\n\tCommandList,\n\tCommandSeparator,\n\tCommandShortcut,\n} from \"@/components/craftui/components/command\";\nimport { Kbd, KbdGroup } from \"@/components/craftui/components/kbd\";\n\nexport default function Particle() {\n\tconst [open, setOpen] = React.useState(false);\n\n\tReact.useEffect(() => {\n\t\tconst down = (e: KeyboardEvent) => {\n\t\t\tif (e.key === \"j\" && (e.metaKey || e.ctrlKey)) {\n\t\t\t\te.preventDefault();\n\t\t\t\tsetOpen((prev) => !prev);\n\t\t\t}\n\t\t};\n\n\t\tdocument.addEventListener(\"keydown\", down);\n\t\treturn () => document.removeEventListener(\"keydown\", down);\n\t}, []);\n\n\treturn (\n\t\t<>\n\t\t\t<Button\n\t\t\t\tvariant=\"outline\"\n\t\t\t\tclassName=\"w-64 justify-between pr-1.5 text-muted-foreground font-normal\"\n\t\t\t\tonClick={() => setOpen(true)}\n\t\t\t>\n\t\t\t\t<span className=\"inline-flex items-center gap-2\">\n\t\t\t\t\t<SearchIcon className=\"size-3.5\" />\n\t\t\t\t\t<span>Search commands...</span>\n\t\t\t\t</span>\n\t\t\t\t<KbdGroup>\n\t\t\t\t\t<Kbd size=\"sm\">⌘</Kbd>\n\t\t\t\t\t<Kbd size=\"sm\">J</Kbd>\n\t\t\t\t</KbdGroup>\n\t\t\t</Button>\n\n\t\t\t<CommandDialog open={open} onOpenChange={setOpen}>\n\t\t\t\t<CommandInput placeholder=\"Type a command or search...\" />\n\t\t\t\t<CommandList>\n\t\t\t\t\t<CommandEmpty>No results found.</CommandEmpty>\n\t\t\t\t\t<CommandGroup heading=\"Suggestions\">\n\t\t\t\t\t\t<CommandItem onSelect={() => setOpen(false)}>\n\t\t\t\t\t\t\t<CalendarIcon />\n\t\t\t\t\t\t\t<span>Calendar</span>\n\t\t\t\t\t\t</CommandItem>\n\t\t\t\t\t\t<CommandItem onSelect={() => setOpen(false)}>\n\t\t\t\t\t\t\t<SmileIcon />\n\t\t\t\t\t\t\t<span>Search Emoji</span>\n\t\t\t\t\t\t</CommandItem>\n\t\t\t\t\t\t<CommandItem onSelect={() => setOpen(false)}>\n\t\t\t\t\t\t\t<CalculatorIcon />\n\t\t\t\t\t\t\t<span>Calculator</span>\n\t\t\t\t\t\t</CommandItem>\n\t\t\t\t\t</CommandGroup>\n\t\t\t\t\t<CommandSeparator />\n\t\t\t\t\t<CommandGroup heading=\"Settings\">\n\t\t\t\t\t\t<CommandItem onSelect={() => setOpen(false)}>\n\t\t\t\t\t\t\t<UserIcon />\n\t\t\t\t\t\t\t<span>Profile</span>\n\t\t\t\t\t\t\t<CommandShortcut>\n\t\t\t\t\t\t\t\t<KbdGroup>\n\t\t\t\t\t\t\t\t\t<Kbd size=\"sm\">⌘</Kbd>\n\t\t\t\t\t\t\t\t\t<Kbd size=\"sm\">P</Kbd>\n\t\t\t\t\t\t\t\t</KbdGroup>\n\t\t\t\t\t\t\t</CommandShortcut>\n\t\t\t\t\t\t</CommandItem>\n\t\t\t\t\t\t<CommandItem onSelect={() => setOpen(false)}>\n\t\t\t\t\t\t\t<CreditCardIcon />\n\t\t\t\t\t\t\t<span>Billing</span>\n\t\t\t\t\t\t\t<CommandShortcut>\n\t\t\t\t\t\t\t\t<KbdGroup>\n\t\t\t\t\t\t\t\t\t<Kbd size=\"sm\">⌘</Kbd>\n\t\t\t\t\t\t\t\t\t<Kbd size=\"sm\">B</Kbd>\n\t\t\t\t\t\t\t\t</KbdGroup>\n\t\t\t\t\t\t\t</CommandShortcut>\n\t\t\t\t\t\t</CommandItem>\n\t\t\t\t\t\t<CommandItem onSelect={() => setOpen(false)}>\n\t\t\t\t\t\t\t<SettingsIcon />\n\t\t\t\t\t\t\t<span>Settings</span>\n\t\t\t\t\t\t\t<CommandShortcut>\n\t\t\t\t\t\t\t\t<KbdGroup>\n\t\t\t\t\t\t\t\t\t<Kbd size=\"sm\">⌘</Kbd>\n\t\t\t\t\t\t\t\t\t<Kbd size=\"sm\">S</Kbd>\n\t\t\t\t\t\t\t\t</KbdGroup>\n\t\t\t\t\t\t\t</CommandShortcut>\n\t\t\t\t\t\t</CommandItem>\n\t\t\t\t\t</CommandGroup>\n\t\t\t\t</CommandList>\n\t\t\t\t<CommandFooter>\n\t\t\t\t\t<div className=\"flex items-center gap-1.5\">\n\t\t\t\t\t\t<Kbd size=\"sm\">\n\t\t\t\t\t\t\t<CornerDownLeftIcon />\n\t\t\t\t\t\t</Kbd>\n\t\t\t\t\t\t<span>Select</span>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div className=\"flex items-center gap-1.5\">\n\t\t\t\t\t\t<Kbd size=\"sm\">Esc</Kbd>\n\t\t\t\t\t\t<span>Close</span>\n\t\t\t\t\t</div>\n\t\t\t\t</CommandFooter>\n\t\t\t</CommandDialog>\n\t\t</>\n\t);\n}\n",
			"type": "registry:component",
			"target": "components/particles/command-dialog.tsx"
		}
	],
	"type": "registry:component"
}
