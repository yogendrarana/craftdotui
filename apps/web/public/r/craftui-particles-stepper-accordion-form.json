			"content": "\"use client\";\n\nimport * as React from \"react\";\nimport { Lock } from \"lucide-react\";\nimport {\n\tAccordionHeader,\n\tAccordionIcon,\n\tAccordionItem,\n\tAccordionPanel,\n\tAccordionRoot,\n\tAccordionTrigger,\n} from \"@/components/baseui/components/accordion\";\nimport { Button } from \"@/components/baseui/components/button\";\nimport {\n\tFieldControl,\n\tFieldDescription,\n\tFieldLabel,\n\tFieldRoot,\n} from \"@/components/baseui/components/field\";\nimport {\n\tStepperIndicator,\n\tStepperItem,\n\tStepperNext,\n\tStepperPrev,\n\tStepperRoot,\n\tStepperTitle,\n} from \"@/components/craftui/components/stepper\";\n\nexport function Particle() {\n\tconst totalSteps = 4;\n\tconst [activeStep, setActiveStep] = React.useState(1);\n\tconst [unlockedStep, setUnlockedStep] = React.useState(1);\n\tconst [openItems, setOpenItems] = React.useState<string[]>([\"step-1\"]);\n\tconst [formData, setFormData] = React.useState({\n\t\tfullName: \"Yogendra Rana\",\n\t\temail: \"yogendra@example.com\",\n\t\tworkspaceName: \"Acme Labs\",\n\t\tsubdomain: \"acme-labs\",\n\t\trole: \"Full-Stack Engineer\",\n\t\tteamSize: \"5-20 members\",\n\t});\n\n\tconst handleStepChange = (nextStep: number) => {\n\t\tsetActiveStep(nextStep);\n\t\tsetUnlockedStep((prev) => Math.max(prev, nextStep));\n\t\tsetOpenItems([`step-${nextStep}`]);\n\t};\n\n\tconst handleAccordionChange = (value: string[]) => {\n\t\t// Only allow opening unlocked steps\n\t\tconst validItems = value.filter((val) => {\n\t\t\tconst stepNum = Number(val.replace(\"step-\", \"\"));\n\t\t\treturn stepNum <= unlockedStep;\n\t\t});\n\t\tsetOpenItems(validItems);\n\t\tif (validItems.length > 0) {\n\t\t\tconst lastOpened = Number(\n\t\t\t\tvalidItems[validItems.length - 1].replace(\"step-\", \"\"),\n\t\t\t);\n\t\t\tsetActiveStep(lastOpened);\n\t\t}\n\t};\n\n\tconst completedCount = Math.max(0, Math.min(unlockedStep - 1, totalSteps));\n\n\treturn (\n\t\t<div className=\"mx-auto w-full max-w-xl overflow-hidden rounded-xl border border-border bg-card shadow-xs\">\n\t\t\t<StepperRoot\n\t\t\t\tvalue={activeStep}\n\t\t\t\tonValueChange={handleStepChange}\n\t\t\t\torientation=\"vertical\"\n\t\t\t\tclassName=\"gap-0\"\n\t\t\t>\n\t\t\t\t<AccordionRoot\n\t\t\t\t\tvalue={openItems}\n\t\t\t\t\tonValueChange={handleAccordionChange}\n\t\t\t\t\tclassName=\"divide-y divide-border\"\n\t\t\t\t>\n\t\t\t\t\t{/* Step 1: Applicant Profile */}\n\t\t\t\t\t<AccordionItem value=\"step-1\" className=\"border-b-0\">\n\t\t\t\t\t\t<StepperItem step={1} className=\"w-full pb-0\">\n\t\t\t\t\t\t\t<AccordionHeader className=\"w-full\">\n\t\t\t\t\t\t\t\t<AccordionTrigger\n\t\t\t\t\t\t\t\t\tdisabled={unlockedStep < 1}\n\t\t\t\t\t\t\t\t\tshowAccordionIcon={false}\n\t\t\t\t\t\t\t\t\tclassName=\"w-full p-4 hover:no-underline\"\n\t\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t\t<div className=\"flex items-center gap-3\">\n\t\t\t\t\t\t\t\t\t\t<StepperIndicator />\n\t\t\t\t\t\t\t\t\t\t<div className=\"flex flex-col text-left\">\n\t\t\t\t\t\t\t\t\t\t\t<StepperTitle>\n\t\t\t\t\t\t\t\t\t\t\t\tApplicant profile\n\t\t\t\t\t\t\t\t\t\t\t</StepperTitle>\n\t\t\t\t\t\t\t\t\t\t\t<span className=\"text-xs text-muted-foreground\">\n\t\t\t\t\t\t\t\t\t\t\t\tContact name and login details\n\t\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<AccordionIcon />\n\t\t\t\t\t\t\t\t</AccordionTrigger>\n\t\t\t\t\t\t\t</AccordionHeader>\n\n\t\t\t\t\t\t\t<AccordionPanel\n\t\t\t\t\t\t\t\tclassName=\"w-full\"\n\t\t\t\t\t\t\t\tinnerClassName=\"px-4 pb-4 pt-0\"\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t<div className=\"flex flex-col gap-4 pl-10\">\n\t\t\t\t\t\t\t\t\t<FieldRoot>\n\t\t\t\t\t\t\t\t\t\t<FieldLabel>Full name</FieldLabel>\n\t\t\t\t\t\t\t\t\t\t<FieldControl\n\t\t\t\t\t\t\t\t\t\t\tplaceholder=\"Jane Doe\"\n\t\t\t\t\t\t\t\t\t\t\tvalue={formData.fullName}\n\t\t\t\t\t\t\t\t\t\t\tonChange={(e) =>\n\t\t\t\t\t\t\t\t\t\t\t\tsetFormData((prev) => ({\n\t\t\t\t\t\t\t\t\t\t\t\t\t...prev,\n\t\t\t\t\t\t\t\t\t\t\t\t\tfullName: e.target.value,\n\t\t\t\t\t\t\t\t\t\t\t\t}))\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t\t\t</FieldRoot>\n\n\t\t\t\t\t\t\t\t\t<FieldRoot>\n\t\t\t\t\t\t\t\t\t\t<FieldLabel>Contact email</FieldLabel>\n\t\t\t\t\t\t\t\t\t\t<FieldControl\n\t\t\t\t\t\t\t\t\t\t\ttype=\"email\"\n\t\t\t\t\t\t\t\t\t\t\tplaceholder=\"jane@company.com\"\n\t\t\t\t\t\t\t\t\t\t\tvalue={formData.email}\n\t\t\t\t\t\t\t\t\t\t\tonChange={(e) =>\n\t\t\t\t\t\t\t\t\t\t\t\tsetFormData((prev) => ({\n\t\t\t\t\t\t\t\t\t\t\t\t\t...prev,\n\t\t\t\t\t\t\t\t\t\t\t\t\temail: e.target.value,\n\t\t\t\t\t\t\t\t\t\t\t\t}))\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t\t\t</FieldRoot>\n\n\t\t\t\t\t\t\t\t\t<div className=\"flex justify-end pt-2\">\n\t\t\t\t\t\t\t\t\t\t<StepperNext\n\t\t\t\t\t\t\t\t\t\t\trender={<Button size=\"sm\" />}\n\t\t\t\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t\t\t\tContinue\n\t\t\t\t\t\t\t\t\t\t</StepperNext>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</AccordionPanel>\n\t\t\t\t\t\t</StepperItem>\n\t\t\t\t\t</AccordionItem>\n\n\t\t\t\t\t{/* Step 2: Workspace Setup */}\n\t\t\t\t\t<AccordionItem value=\"step-2\" className=\"border-b-0\">\n\t\t\t\t\t\t<StepperItem\n\t\t\t\t\t\t\tstep={2}\n\t\t\t\t\t\t\tdisabled={unlockedStep < 2}\n\t\t\t\t\t\t\tclassName=\"w-full pb-0\"\n\t\t\t\t\t\t>\n\t\t\t\t\t\t\t<AccordionHeader className=\"w-full\">\n\t\t\t\t\t\t\t\t<AccordionTrigger\n\t\t\t\t\t\t\t\t\tdisabled={unlockedStep < 2}\n\t\t\t\t\t\t\t\t\tshowAccordionIcon={false}\n\t\t\t\t\t\t\t\t\tclassName=\"w-full p-4 hover:no-underline\"\n\t\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t\t<div className=\"flex items-center gap-3\">\n\t\t\t\t\t\t\t\t\t\t<StepperIndicator>\n\t\t\t\t\t\t\t\t\t\t\t{unlockedStep < 2 ? (\n\t\t\t\t\t\t\t\t\t\t\t\t<Lock />\n\t\t\t\t\t\t\t\t\t\t\t) : undefined}\n\t\t\t\t\t\t\t\t\t\t</StepperIndicator>\n\t\t\t\t\t\t\t\t\t\t<div className=\"flex flex-col text-left\">\n\t\t\t\t\t\t\t\t\t\t\t<StepperTitle>\n\t\t\t\t\t\t\t\t\t\t\t\tWorkspace setup\n\t\t\t\t\t\t\t\t\t\t\t</StepperTitle>\n\t\t\t\t\t\t\t\t\t\t\t<span className=\"text-xs text-muted-foreground\">\n\t\t\t\t\t\t\t\t\t\t\t\t{unlockedStep < 2\n\t\t\t\t\t\t\t\t\t\t\t\t\t? \"Opens after Applicant profile\"\n\t\t\t\t\t\t\t\t\t\t\t\t\t: \"Define company name and custom URL\"}\n\t\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<AccordionIcon />\n\t\t\t\t\t\t\t\t</AccordionTrigger>\n\t\t\t\t\t\t\t</AccordionHeader>\n\n\t\t\t\t\t\t\t<AccordionPanel\n\t\t\t\t\t\t\t\tclassName=\"w-full\"\n\t\t\t\t\t\t\t\tinnerClassName=\"px-4 pb-4 pt-0\"\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t<div className=\"flex flex-col gap-4 pl-10\">\n\t\t\t\t\t\t\t\t\t<FieldRoot>\n\t\t\t\t\t\t\t\t\t\t<FieldLabel>Workspace name</FieldLabel>\n\t\t\t\t\t\t\t\t\t\t<FieldControl\n\t\t\t\t\t\t\t\t\t\t\tplaceholder=\"Acme Corp\"\n\t\t\t\t\t\t\t\t\t\t\tvalue={formData.workspaceName}\n\t\t\t\t\t\t\t\t\t\t\tonChange={(e) =>\n\t\t\t\t\t\t\t\t\t\t\t\tsetFormData((prev) => ({\n\t\t\t\t\t\t\t\t\t\t\t\t\t...prev,\n\t\t\t\t\t\t\t\t\t\t\t\t\tworkspaceName:\n\t\t\t\t\t\t\t\t\t\t\t\t\t\te.target.value,\n\t\t\t\t\t\t\t\t\t\t\t\t}))\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t\t\t</FieldRoot>\n\n\t\t\t\t\t\t\t\t\t<FieldRoot>\n\t\t\t\t\t\t\t\t\t\t<FieldLabel>Domain prefix</FieldLabel>\n\t\t\t\t\t\t\t\t\t\t<FieldControl\n\t\t\t\t\t\t\t\t\t\t\tplaceholder=\"acme\"\n\t\t\t\t\t\t\t\t\t\t\tvalue={formData.subdomain}\n\t\t\t\t\t\t\t\t\t\t\tonChange={(e) =>\n\t\t\t\t\t\t\t\t\t\t\t\tsetFormData((prev) => ({\n\t\t\t\t\t\t\t\t\t\t\t\t\t...prev,\n\t\t\t\t\t\t\t\t\t\t\t\t\tsubdomain: e.target.value,\n\t\t\t\t\t\t\t\t\t\t\t\t}))\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t\t\t\t<FieldDescription>\n\t\t\t\t\t\t\t\t\t\t\thttps://\n\t\t\t\t\t\t\t\t\t\t\t{formData.subdomain || \"acme\"}\n\t\t\t\t\t\t\t\t\t\t\t.craftdotui.com\n\t\t\t\t\t\t\t\t\t\t</FieldDescription>\n\t\t\t\t\t\t\t\t\t</FieldRoot>\n\n\t\t\t\t\t\t\t\t\t<div className=\"flex ite