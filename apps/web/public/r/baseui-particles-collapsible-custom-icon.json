			"content": "import { ArrowRight, ChevronsUpDown, Sparkles } from \"lucide-react\";\nimport {\n\tCollapsibleRoot,\n\tCollapsiblePanel,\n\tCollapsibleTrigger,\n\tCollapsibleIcon,\n} from \"@/components/baseui/components/collapsible\";\n\nexport default function Particle() {\n\treturn (\n\t\t<div className=\"flex w-full flex-col items-center gap-4 p-4\">\n\t\t\t{/* Custom Icon wrapped in CollapsibleIcon */}\n\t\t\t<CollapsibleRoot className=\"w-full max-w-sm\">\n\t\t\t\t<CollapsibleTrigger>\n\t\t\t\t\t<span className=\"flex items-center gap-2\">\n\t\t\t\t\t\t<Sparkles className=\"size-4 text-primary\" />\n\t\t\t\t\t\t<span>Wrapped Custom Icon</span>\n\t\t\t\t\t</span>\n\t\t\t\t\t<CollapsibleIcon>\n\t\t\t\t\t\t<ChevronsUpDown />\n\t\t\t\t\t</CollapsibleIcon>\n\t\t\t\t</CollapsibleTrigger>\n\t\t\t\t<CollapsiblePanel>\n\t\t\t\t\t<div className=\"pt-2\">\n\t\t\t\t\t\t<div className=\"rounded-md border border-border/60 bg-muted/40 p-3 text-xs text-muted-foreground\">\n\t\t\t\t\t\t\tWrapping any icon with{\" \"}\n\t\t\t\t\t\t\t<code className=\"text-foreground\">\n\t\t\t\t\t\t\t\t&lt;CollapsibleIcon&gt;\n\t\t\t\t\t\t\t</code>{\" \"}\n\t\t\t\t\t\t\tprovides automatic rotation and transitions.\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</CollapsiblePanel>\n\t\t\t</CollapsibleRoot>\n\n\t\t\t{/* Direct CollapsibleIcon with custom arrow */}\n\t\t\t<CollapsibleRoot className=\"w-full max-w-sm\">\n\t\t\t\t<CollapsibleTrigger variant=\"outline\">\n\t\t\t\t\t<span className=\"flex items-center gap-2\">\n\t\t\t\t\t\t<span>Direct Arrow Indicator</span>\n\t\t\t\t\t</span>\n\t\t\t\t\t<CollapsibleIcon className=\"text-primary\">\n\t\t\t\t\t\t<ArrowRight />\n\t\t\t\t\t</CollapsibleIcon>\n\t\t\t\t</CollapsibleTrigger>\n\t\t\t\t<CollapsiblePanel>\n\t\t\t\t\t<div className=\"pt-2\">\n\t\t\t\t\t\t<div className=\"rounded-md border border-border/60 bg-muted/40 p-3 text-xs text-muted-foreground\">\n\t\t\t\t\t\t\tUsing{\" \"}\n\t\t\t\t\t\t\t<code className=\"text-foreground\">\n\t\t\t\t\t\t\t\t&lt;CollapsibleIcon&gt;\n\t\t\t\t\t\t\t</code>{\" \"}\n\t\t\t\t\t\t\tdirectly inside the trigger gives you complete\n\t\t\t\t\t\t\tcontrol over icon choice, placement, and styling.\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</CollapsiblePanel>\n\t\t\t</CollapsibleRoot>\n\t\t</div>\n\t);\n}\n",
			"type": "registry:component",
