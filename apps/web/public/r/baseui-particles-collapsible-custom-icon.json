			"content": "import { ArrowRight, ChevronsUpDown, Sparkles } from \"lucide-react\";\nimport {\n\tCollapsibleRoot,\n\tCollapsiblePanel,\n\tCollapsibleTrigger,\n\tCollapsibleIcon,\n} from \"@/components/baseui/components/collapsible\";\n\nexport default function Particle() {\n\treturn (\n\t\t<div className=\"flex w-full flex-col items-center gap-4 p-4\">\n\t\t\t{/* Custom Icon via Trigger icon prop */}\n\t\t\t<CollapsibleRoot className=\"w-full max-w-sm\">\n\t\t\t\t<CollapsibleTrigger icon={ChevronsUpDown}>\n\t\t\t\t\t<span className=\"flex items-center gap-2\">\n\t\t\t\t\t\t<Sparkles className=\"size-4 text-primary\" />\n\t\t\t\t\t\t<span>Trigger with icon prop</span>\n\t\t\t\t\t</span>\n\t\t\t\t</CollapsibleTrigger>\n\t\t\t\t<CollapsiblePanel>\n\t\t\t\t\t<div className=\"pt-2\">\n\t\t\t\t\t\t<div className=\"rounded-md border border-border/60 bg-muted/40 p-3 text-xs text-muted-foreground\">\n\t\t\t\t\t\t\tThe <code className=\"text-foreground\">icon</code>{\" \"}\n\t\t\t\t\t\t\tprop replaces the default ChevronRight with any\n\t\t\t\t\t\t\tcustom icon component.\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</CollapsiblePanel>\n\t\t\t</CollapsibleRoot>\n\n\t\t\t{/* Direct CollapsibleIcon Component */}\n\t\t\t<CollapsibleRoot className=\"w-full max-w-sm\">\n\t\t\t\t<CollapsibleTrigger\n\t\t\t\t\tvariant=\"outline\"\n\t\t\t\t\tshowCollapsibleIcon={false}\n\t\t\t\t>\n\t\t\t\t\t<span className=\"flex items-center gap-2\">\n\t\t\t\t\t\t<span>Direct CollapsibleIcon</span>\n\t\t\t\t\t</span>\n\t\t\t\t\t<CollapsibleIcon\n\t\t\t\t\t\ticon={ArrowRight}\n\t\t\t\t\t\tclassName=\"size-4 text-primary\"\n\t\t\t\t\t/>\n\t\t\t\t</CollapsibleTrigger>\n\t\t\t\t<CollapsiblePanel>\n\t\t\t\t\t<div className=\"pt-2\">\n\t\t\t\t\t\t<div className=\"rounded-md border border-border/60 bg-muted/40 p-3 text-xs text-muted-foreground\">\n\t\t\t\t\t\t\tUsing{\" \"}\n\t\t\t\t\t\t\t<code className=\"text-foreground\">\n\t\t\t\t\t\t\t\t&lt;CollapsibleIcon /&gt;\n\t\t\t\t\t\t\t</code>{\" \"}\n\t\t\t\t\t\t\tdirectly gives you complete control over icon\n\t\t\t\t\t\t\tplacement and styling.\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</CollapsiblePanel>\n\t\t\t</CollapsibleRoot>\n\t\t</div>\n\t);\n}\n",
			"type": "registry:component",
			"target": "components/baseui/particles/collapsible-custom-icon.tsx"
		}
	],
