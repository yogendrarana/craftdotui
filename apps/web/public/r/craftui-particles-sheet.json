			"content": "import { Button } from \"@/components/baseui/components/button\";\nimport { Input } from \"@/components/baseui/components/input\";\nimport { Label } from \"@/components/craftui/components/label\";\nimport {\n\tSheetClose,\n\tSheetContent,\n\tSheetDescription,\n\tSheetFooter,\n\tSheetHeader,\n\tSheetPanel,\n\tSheetRoot,\n\tSheetTitle,\n\tSheetTrigger,\n} from \"@/components/craftui/components/sheet\";\n\nexport default function Particle() {\n\treturn (\n\t\t<SheetRoot>\n\t\t\t<SheetTrigger render={<Button variant=\"outline\" />}>\n\t\t\t\tOpen Sheet\n\t\t\t</SheetTrigger>\n\t\t\t<SheetContent>\n\t\t\t\t<SheetHeader>\n\t\t\t\t\t<SheetTitle>Edit Profile</SheetTitle>\n\t\t\t\t\t<SheetDescription>\n\t\t\t\t\t\tMake changes to your public profile here. Click save\n\t\t\t\t\t\twhen you are done.\n\t\t\t\t\t</SheetDescription>\n\t\t\t\t</SheetHeader>\n\t\t\t\t<SheetPanel className=\"gap-4\">\n\t\t\t\t\t<div className=\"flex flex-col gap-2\">\n\t\t\t\t\t\t<Label htmlFor=\"sheet-name\">Full name</Label>\n\t\t\t\t\t\t<Input id=\"sheet-name\" defaultValue=\"Yogendra Rana\" />\n\t\t\t\t\t</div>\n\t\t\t\t\t<div className=\"flex flex-col gap-2\">\n\t\t\t\t\t\t<Label htmlFor=\"sheet-username\">Username</Label>\n\t\t\t\t\t\t<Input\n\t\t\t\t\t\t\tid=\"sheet-username\"\n\t\t\t\t\t\t\tdefaultValue=\"@yooogendra_rana\"\n\t\t\t\t\t\t/>\n\t\t\t\t\t</div>\n\t\t\t\t</SheetPanel>\n\t\t\t\t<SheetFooter>\n\t\t\t\t\t<SheetClose render={<Button variant=\"ghost\" />}>\n\t\t\t\t\t\tCancel\n\t\t\t\t\t</SheetClose>\n\t\t\t\t\t<Button>Save changes</Button>\n\t\t\t\t</SheetFooter>\n\t\t\t</SheetContent>\n\t\t</SheetRoot>\n\t);\n}\n",
			"type": "registry:component",
			"target": "components/particles/sheet.tsx"
		}
