sx\")\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t\t\t\t\t<Trash2 className=\"size-3\" />\n\t\t\t\t\t\t\t\t\t\t\t</button>\n\t\t\t\t\t\t\t\t\t\t</TreeItemActions>\n\t\t\t\t\t\t\t\t\t</TreeItemTrigger>\n\t\t\t\t\t\t\t\t</TreeItem>\n\n\t\t\t\t\t\t\t\t<TreeItem\n\t\t\t\t\t\t\t\t\tvalue=\"layout.tsx\"\n\t\t\t\t\t\t\t\t\tlabel=\"layout.tsx\"\n\t\t\t\t\t\t\t\t\tisLeaf\n\t\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t\t<TreeItemTrigger>\n\t\t\t\t\t\t\t\t\t\t<TreeItemChevron />\n\t\t\t\t\t\t\t\t\t\t<TreeItemIcon\n\t\t\t\t\t\t\t\t\t\t\tfileIcon={\n\t\t\t\t\t\t\t\t\t\t\t\t<FileCode className=\"size-4 text-sky-500\" />\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t\t\t\t<TreeItemLabel>\n\t\t\t\t\t\t\t\t\t\t\tlayout.tsx\n\t\t\t\t\t\t\t\t\t\t</TreeItemLabel>\n\t\t\t\t\t\t\t\t\t</TreeItemTrigger>\n\t\t\t\t\t\t\t\t</TreeItem>\n\n\t\t\t\t\t\t\t\t<TreeItem\n\t\t\t\t\t\t\t\t\tvalue=\"globals.css\"\n\t\t\t\t\t\t\t\t\tlabel=\"globals.css\"\n\t\t\t\t\t\t\t\t\tisLeaf\n\t\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t\t<TreeItemTrigger>\n\t\t\t\t\t\t\t\t\t\t<TreeItemChevron />\n\t\t\t\t\t\t\t\t\t\t<TreeItemIcon\n\t\t\t\t\t\t\t\t\t\t\tfileIcon={\n\t\t\t\t\t\t\t\t\t\t\t\t<FileCode className=\"size-4 text-pink-500\" />\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t\t\t\t<TreeItemLabel>\n\t\t\t\t\t\t\t\t\t\t\tglobals.css\n\t\t\t\t\t\t\t\t\t\t</TreeItemLabel>\n\t\t\t\t\t\t\t\t\t</TreeItemTrigger>\n\t\t\t\t\t\t\t\t</TreeItem>\n\t\t\t\t\t\t\t</TreeItemContent>\n\t\t\t\t\t\t</TreeItem>\n\n\t\t\t\t\t\t<TreeItem value=\"assets\" label=\"assets\">\n\t\t\t\t\t\t\t<TreeItemTrigger>\n\t\t\t\t\t\t\t\t<TreeItemChevron />\n\t\t\t\t\t\t\t\t<TreeItemIcon />\n\t\t\t\t\t\t\t\t<TreeItemLabel>assets</TreeItemLabel>\n\t\t\t\t\t\t\t</TreeItemTrigger>\n\t\t\t\t\t\t\t<TreeItemContent>\n\t\t\t\t\t\t\t\t<TreeItem\n\t\t\t\t\t\t\t\t\tvalue=\"logo.svg\"\n\t\t\t\t\t\t\t\t\tlabel=\"logo.svg\"\n\t\t\t\t\t\t\t\t\tisLeaf\n\t\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t\t<TreeItemTrigger>\n\t\t\t\t\t\t\t\t\t\t<TreeItemChevron />\n\t\t\t\t\t\t\t\t\t\t<TreeItemIcon\n\t\t\t\t\t\t\t\t\t\t\tfileIcon={\n\t\t\t\t\t\t\t\t\t\t\t\t<FileImage className=\"size-4 text-emerald-500\" />\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t\t\t\t<TreeItemLabel>logo.svg</TreeItemLabel>\n\t\t\t\t\t\t\t\t\t</TreeItemTrigger>\n\t\t\t\t\t\t\t\t</TreeItem>\n\t\t\t\t\t\t\t</TreeItemContent>\n\t\t\t\t\t\t</TreeItem>\n\t\t\t\t\t</TreeItemContent>\n\t\t\t\t</TreeItem>\n\n\t\t\t\t<TreeItem value=\"package.json\" label=\"package.json\" isLeaf>\n\t\t\t\t\t<TreeItemTrigger>\n\t\t\t\t\t\t<TreeItemChevron />\n\t\t\t\t\t\t<TreeItemIcon\n\t\t\t\t\t\t\tfileIcon={\n\t\t\t\t\t\t\t\t<FileJson className=\"size-4 text-amber-500\" />\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t/>\n\t\t\t\t\t\t<TreeItemLabel>package.json</TreeItemLabel>\n\t\t\t\t\t</TreeItemTrigger>\n\t\t\t\t</TreeItem>\n\n\t\t\t\t<TreeItem value=\"README.md\" label=\"README.md\" isLeaf>\n\t\t\t\t\t<TreeItemTrigger>\n\t\t\t\t\t\t<TreeItemChevron />\n\t\t\t\t\t\t<TreeItemIcon\n\t\t\t\t\t\t\tfileIcon={\n\t\t\t\t\t\t\t\t<FileText className=\"size-4 text-muted-foreground\" />\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t/>\n\t\t\t\t\t\t<TreeItemLabel>README.md</TreeItemLabel>\n\t\t\t\t\t</TreeItemTrigger>\n\t\t\t\t</TreeItem>\n\t\t\t</TreeRoot>\n\t\t</div>\n\t);\n}\n\nexport default Particle;\n",
